# Application runtime
APP_ENV=development
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=*

# AI / RAG provider
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite:///./tourism.db

# Travel Explorer provider policy
TRAVEL_PROVIDER_MODE=auto

# Application-controlled daily safety limit for Geoapify
GEOAPIFY_DAILY_LIMIT=500


# Primary provider credentials
GEOAPIFY_API_KEY=


# OpenStreetMap fallback
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSM_USER_AGENT=AI-Smart-Tourism-Ecosystem/1.0 (student project)
# Maximum radius used by the OSM fallback for state/region searches
OSM_REGION_SEARCH_RADIUS_METERS=50000

# Optional quota persistence path
# TRAVEL_QUOTA_STORAGE_PATH=app/data/provider_usage.json
